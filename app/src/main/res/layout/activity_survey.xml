<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF7FF"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="18dp"
    android:paddingBottom="18dp">

    <!-- 제목 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="설문 작성"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:gravity="center" />

    <!-- 설문 주제 -->
    <TextView
        android:id="@+id/tv_survey_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginTop="22dp" />

    <!-- 설명 -->
    <TextView
        android:id="@+id/tv_survey_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="9sp"
        android:textColor="#000000"
        android:layout_marginTop="8dp" />

    <!-- 척도 설명 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1 - 전혀 그렇지 않다 / 5 - 매우 그렇다"
        android:textSize="9sp"
        android:textColor="#666666"
        android:layout_marginTop="18dp" />

    <!-- 문항 박스들이 들어갈 스크롤 영역 -->
    <ScrollView
        android:id="@+id/question_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="14dp"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/question_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

    <!-- 제출 버튼 -->
    <Button
        android:id="@+id/btnSubmit"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="제출하기"
        android:textSize="12sp"
        android:textColor="#FFFFFF"
        android:enabled="true"
        android:clickable="true"
        android:background="@drawable/survey_submit_button"
        android:backgroundTint="@null"
        android:layout_marginTop="14dp" />

</LinearLayout>