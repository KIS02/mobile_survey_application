<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="40dp"

    android:background="#FFFFFF">

    <!-- 제목 왼쪽 레이아웃 유지용 빈 공간 -->
    <View
        android:id="@+id/headerLogoSpacer"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 텍스트 -->
    <TextView
        android:id="@+id/headerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="마이페이지"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#111111"
        app:layout_constraintStart_toEndOf="@id/headerLogoSpacer"
        app:layout_constraintTop_toTopOf="@id/headerLogoSpacer"
        app:layout_constraintBottom_toBottomOf="@id/headerLogoSpacer" />

    <!-- 설정 아이콘 -->
    <ImageView
        android:id="@+id/headerSettings"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_setting"
        android:contentDescription="@string/settings"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="#111111"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- 아래 선 -->
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="#DDDDDD"
        app:layout_constraintTop_toBottomOf="@id/headerLogoSpacer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
