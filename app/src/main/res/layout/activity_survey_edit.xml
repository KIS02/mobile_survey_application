<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- 상단 앱바 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#6750A4"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="뒤로가기" />

        <TextView
            android:id="@+id/tv_toolbar_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="설문 수정"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ACTIVE 상태 안내 -->
    <TextView
        android:id="@+id/tv_active_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="활성화된 설문입니다. 시작일/종료일만 수정 가능합니다."
        android:textSize="13sp"
        android:textColor="#FFFFFF"
        android:background="#FF8F00"
        android:padding="10dp"
        android:gravity="center"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/et_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="설문 제목 *"
                android:inputType="text"
                android:background="@android:color/white"
                android:padding="12dp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_description"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:hint="설문 설명 (선택)"
                android:inputType="textMultiLine"
                android:gravity="top"
                android:background="@android:color/white"
                android:padding="12dp"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spinner_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/white"
                android:padding="4dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <EditText
                    android:id="@+id/et_reward"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="리워드 크레딧"
                    android:inputType="number"
                    android:background="@android:color/white"
                    android:padding="12dp"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/et_target_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="목표 응답 수"
                    android:inputType="number"
                    android:background="@android:color/white"
                    android:padding="12dp" />
            </LinearLayout>

            <!-- 타겟 조건 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="타겟 조건 (선택)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#6750A4"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinner_gender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/white"
                android:padding="4dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/et_age_min"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="최소 나이"
                    android:inputType="number"
                    android:background="@android:color/white"
                    android:padding="12dp"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/et_age_max"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="최대 나이"
                    android:inputType="number"
                    android:background="@android:color/white"
                    android:padding="12dp" />
            </LinearLayout>

            <!-- 일정 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="설문 일정"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#6750A4"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/et_start_at"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="시작일시 (예: 2026-06-10 09:00)"
                android:inputType="text"
                android:background="@android:color/white"
                android:padding="12dp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_end_at"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="종료일시 (예: 2026-07-10 23:59)"
                android:inputType="text"
                android:background="@android:color/white"
                android:padding="12dp"
                android:layout_marginBottom="16dp" />

        </LinearLayout>
    </ScrollView>

    <!-- 하단 저장 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:elevation="8dp"
        android:padding="16dp">

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="저장"
            android:textSize="16sp"
            android:backgroundTint="#6750A4"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />
</LinearLayout>
