<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".fragment.FragmentCategoryChange">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="←"
                android:textColor="#111111"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="카테고리 변경"
                android:textColor="#111111"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Count Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_profile_edit_field"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="선호하는 카테고리를 최대 5개까지 선택할 수 있습니다."
                android:textColor="#999999"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/txtCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0 / 5 선택됨"
                android:textColor="#222222"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="20dp">

                <!-- Category Item -->
                <CheckBox
                    android:id="@+id/checkFood"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_category_item"
                    android:buttonTint="#7B61FF"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:text="음식"
                    android:textColor="#222222"
                    android:textSize="15sp" />

                <CheckBox
                    android:id="@+id/checkTravel"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_category_item"
                    android:buttonTint="#7B61FF"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:text="여행"
                    android:textColor="#222222"
                    android:textSize="15sp" />

                <CheckBox
                    android:id="@+id/checkAnimal"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_category_item"
                    android:buttonTint="#7B61FF"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:text="동물"
                    android:textColor="#222222"
                    android:textSize="15sp" />

                <CheckBox
                    android:id="@+id/checkGame"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_category_item"
                    android:buttonTint="#7B61FF"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:text="게임"
                    android:textColor="#222222"
                    android:textSize="15sp" />

                <CheckBox
                    android:id="@+id/checkIT"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_category_item"
                    android:buttonTint="#7B61FF"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:text="IT / 전자기기"
                    android:textColor="#222222"
                    android:textSize="15sp" />

                <CheckBox
                    android:id="@+id/checkSports"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_category_item"
                    android:buttonTint="#7B61FF"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:text="스포츠"
                    android:textColor="#222222"
                    android:textSize="15sp" />

            </LinearLayout>
        </ScrollView>

        <!-- Save Button -->
        <TextView
            android:id="@+id/btnSaveCategory"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_reward_button"
            android:gravity="center"
            android:text="카테고리 저장하기"
            android:textColor="#444444"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>