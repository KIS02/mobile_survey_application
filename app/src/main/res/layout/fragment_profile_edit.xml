<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".fragment.FragmentProfileEdit">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="←"
                android:textColor="#111111"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="프로필"
                android:textColor="#111111"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="20dp">

                <FrameLayout
                    android:id="@+id/profileImageArea"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    android:clickable="false"
                    android:focusable="false">

                    <ImageView
                        android:id="@+id/imgProfile"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_profile_default" />

                </FrameLayout>

                <!-- Profile Info Container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:layout_marginTop="32dp"
                    android:orientation="vertical">
                    <!-- Name -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="이름"
                            android:textColor="#999999"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/etProfileName"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@android:color/transparent"
                            android:hint="이름"
                            android:maxLength="20"
                            android:paddingStart="0dp"
                            android:textColor="#222222"
                            android:textSize="15sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E5E5E5" />
                    </LinearLayout>

                    <!-- Phone -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="전화번호"
                            android:textColor="#999999"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/etProfileTelephone"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@android:color/transparent"
                            android:hint="01012345678"
                            android:inputType="number"
                            android:maxLength="13"
                            android:paddingStart="0dp"
                            android:textColor="#222222"
                            android:textSize="15sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E5E5E5" />
                    </LinearLayout>

                    <!-- Nickname -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="닉네임"
                            android:textColor="#999999"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/etProfileNickname"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@android:color/transparent"
                            android:hint="닉네임"
                            android:maxLength="12"
                            android:paddingStart="0dp"
                            android:textColor="#222222"
                            android:textSize="15sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E5E5E5" />
                    </LinearLayout>

                    <!-- Birth -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="생일"
                            android:textColor="#999999"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/etProfileBirthDate"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@android:color/transparent"
                            android:hint="20010505"
                            android:inputType="number"
                            android:maxLength="10"
                            android:paddingStart="0dp"
                            android:textColor="#222222"
                            android:textSize="15sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E5E5E5" />
                    </LinearLayout>

                    <!-- Address -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="거주지"
                            android:textColor="#999999"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/etProfileLocation"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@android:color/transparent"
                            android:hint="거주지"
                            android:paddingStart="0dp"
                            android:textColor="#222222"
                            android:textSize="15sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E5E5E5" />
                    </LinearLayout>

                    <!-- Region -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="지역"
                            android:textColor="#999999"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/etProfileRegion"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@android:color/transparent"
                            android:hint="지역"
                            android:paddingStart="0dp"
                            android:textColor="#222222"
                            android:textSize="15sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E5E5E5" />
                    </LinearLayout>
                </LinearLayout>




                <!-- Category -->
                <LinearLayout
                    android:id="@+id/btnCategory"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/bg_mypage_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="관심 카테고리"
                            android:textColor="#999999"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtCategory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="선택된 카테고리: 없음"
                            android:textColor="#222222"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#111111"
                        android:textSize="30sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <TextView
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_reward_button"
            android:gravity="center"
            android:text="수정사항 저장하기"
            android:textColor="#444444"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>