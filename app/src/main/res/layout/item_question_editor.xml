<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 문항 헤더 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_question_number"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="문항 1"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1976D2" />

            <Button
                android:id="@+id/btn_delete_question"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="삭제"
                android:textSize="12sp"
                android:backgroundTint="#FFEBEE"
                android:textColor="#D32F2F"
                android:paddingHorizontal="12dp" />
        </LinearLayout>

        <!-- 문항 텍스트 -->
        <EditText
            android:id="@+id/et_question_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="문항 내용 *"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:background="@android:color/white"
            android:padding="10dp"
            android:layout_marginBottom="8dp" />

        <!-- 문항 유형 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="문항 유형"
            android:textSize="12sp"
            android:textColor="#666666"
            android:layout_marginBottom="2dp" />

        <Spinner
            android:id="@+id/spinner_question_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:padding="4dp"
            android:layout_marginBottom="8dp" />

        <!-- 지시 문항 정답 순서 (지시 선택 시에만 표시) -->
        <LinearLayout
            android:id="@+id/layout_correct_order"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="정답 선택지 순서 (예: 3)"
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginBottom="2dp" />

            <EditText
                android:id="@+id/et_correct_order"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="정답 번호 *"
                android:inputType="number"
                android:background="@android:color/white"
                android:padding="10dp" />
        </LinearLayout>

        <!-- 선택지 세트 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="선택지 세트"
            android:textSize="12sp"
            android:textColor="#666666"
            android:layout_marginBottom="2dp" />

        <Spinner
            android:id="@+id/spinner_option_set"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:padding="4dp" />

        <!-- 선택지 미리보기 -->
        <LinearLayout
            android:id="@+id/container_option_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
